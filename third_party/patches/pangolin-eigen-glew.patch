diff --git a/components/pango_windowing/CMakeLists.txt b/components/pango_windowing/CMakeLists.txt
--- a/components/pango_windowing/CMakeLists.txt
+++ b/components/pango_windowing/CMakeLists.txt
@@ -31,6 +31,19 @@
     endif()
 
     # Wayland
+    if(NOT PKG_CONFIG_EXECUTABLE)
+        foreach(_pkg_config_candidate
+            /usr/bin/pkg-config
+            /usr/local/bin/pkg-config
+            /opt/homebrew/bin/pkg-config
+            /opt/local/bin/pkg-config
+        )
+            if(EXISTS "${_pkg_config_candidate}")
+                set(PKG_CONFIG_EXECUTABLE "${_pkg_config_candidate}" CACHE FILEPATH "pkg-config executable" FORCE)
+                break()
+            endif()
+        endforeach()
+    endif()
     find_package(PkgConfig)
     pkg_check_modules(WAYLAND_CLIENT wayland-client QUIET)
     pkg_check_modules(wayland-protocols QUIET wayland-protocols>=1.13)
diff --git a/cmake/FindEigen3.cmake b/cmake/FindEigen3.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/FindEigen3.cmake
@@ -0,0 +1,19 @@
+if(NOT EIGEN3_INCLUDE_DIR)
+  message(FATAL_ERROR "EIGEN3_INCLUDE_DIR must be set by Bazel")
+endif()
+
+if(NOT IS_ABSOLUTE "${EIGEN3_INCLUDE_DIR}")
+  get_filename_component(
+    EIGEN3_INCLUDE_DIR
+    "$ENV{EXT_BUILD_ROOT}/${EIGEN3_INCLUDE_DIR}"
+    ABSOLUTE
+  )
+endif()
+
+set(EIGEN3_INCLUDE_DIRS "${EIGEN3_INCLUDE_DIR}")
+set(Eigen3_FOUND TRUE)
+
+if(NOT TARGET Eigen3::Eigen)
+  add_library(Eigen3::Eigen INTERFACE IMPORTED)
+  set_target_properties(Eigen3::Eigen PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${EIGEN3_INCLUDE_DIR}")
+endif()
